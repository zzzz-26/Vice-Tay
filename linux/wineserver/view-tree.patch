+/* Views of all processes, ordered by process then base address. Views of a
+ * process never overlap (is_valid_view_addr is checked before each is added),
+ * so looking up an address is a search for the view with the nearest base at
+ * or below it. The per-process list stays for its order (main exe first, then
+ * load order), which the debug events and get_exe_view use. */
+struct view_key
+{
+    const struct process *process;
+    client_ptr_t          base;
+};
+
+static int compare_view_key( const struct view_key *key, const struct memory_view *view )
+{
+    if (key->process != view->process)
+        return (uintptr_t)key->process < (uintptr_t)view->process ? -1 : 1;
+    if (key->base != view->base) return key->base < view->base ? -1 : 1;
+    return 0;
+}
+
+static int compare_view( const void *key, const struct rb_entry *entry )
+{
+    return compare_view_key( key, RB_ENTRY_VALUE( entry, const struct memory_view, tree_entry ));
+}
+
+static struct rb_tree view_tree = { compare_view };
+
+/* the view of the process with the highest base at or below addr */
+static struct memory_view *find_view_at_or_below( struct process *process, client_ptr_t addr )
+{
+    struct view_key key = { process, addr };
+    struct rb_entry *entry = view_tree.root;
+    struct memory_view *found = NULL;
+
+    while (entry)
+    {
+        struct memory_view *view = RB_ENTRY_VALUE( entry, struct memory_view, tree_entry );
+        int c = compare_view_key( &key, view );
+        if (!c) return view;
+        if (c < 0) entry = entry->left;
+        else
+        {
+            found = view;
+            entry = entry->right;
+        }
+    }
+    return found && found->process == process ? found : NULL;
+}
+
+/* the view of the process with the lowest base above addr */
+static struct memory_view *find_view_above( struct process *process, client_ptr_t addr )
+{
+    struct view_key key = { process, addr };
+    struct rb_entry *entry = view_tree.root;
+    struct memory_view *found = NULL;
+
+    while (entry)
+    {
+        struct memory_view *view = RB_ENTRY_VALUE( entry, struct memory_view, tree_entry );
+        if (compare_view_key( &key, view ) < 0)
+        {
+            found = view;
+            entry = entry->left;
+        }
+        else entry = entry->right;
+    }
+    return found && found->process == process ? found : NULL;
+}
+
 /* find a memory view from its base address */
 struct memory_view *find_mapped_view( struct process *process, client_ptr_t base )
 {
-    struct memory_view *view;
-
-    LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
-        if (view->base == base) return view;
+    struct view_key key = { process, base };
+    struct rb_entry *entry = rb_get( &view_tree, &key );
 
+    if (entry) return RB_ENTRY_VALUE( entry, struct memory_view, tree_entry );
     set_error( STATUS_NOT_MAPPED_VIEW );
     return NULL;
 }
